@page
@model MasterBooking.Web.Pages.CalendarModel
@{
    ViewData["Title"] = Model.Settings?.DisplayName ?? "Календарь";
}

@if (Model.Settings != null)
{
    <section class="w" style="padding-bottom:16px">
        <h2 class="s" style="margin-bottom:8px">Свободное время</h2>
        <p style="margin:0 0 24px;color:#4A4558">Серым отмечено занятое время. Чтобы записаться, оставьте заявку ниже, напишите или позвоните мастеру.</p>
        <div style="overflow-x:auto">
            <div class="card cal">
                @foreach (var day in Model.Week)
                {
                    <div class="d">
                        <h3>@day.Title</h3>
                        @foreach (var slot in day.Slots)
                        {
                            <div class="sl@(slot.Busy ? " b" : "")">@slot.Text</div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <partial name="_RequestForm" model="Model" />
}
