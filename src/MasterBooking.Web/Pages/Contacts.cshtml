@page
@model MasterBooking.Web.Pages.ContactsModel
@{
    ViewData["Title"] = Model.Settings?.DisplayName ?? "Контакты";
}

@if (Model.Settings != null)
{
    <section class="w">
        <h2 class="s">Контакты</h2>
        <div style="display:flex;gap:32px;flex-wrap:wrap;font-size:18px;font-weight:600">
            @if (!string.IsNullOrWhiteSpace(Model.Settings.PhoneNumber))
            {
                <span>@Model.Settings.PhoneNumber</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Settings.SocialLinks))
            {
                <span>@Model.Settings.SocialLinks</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Settings.Address))
            {
                <span>@Model.Settings.Address</span>
            }
        </div>
        <div class="ph" style="height:320px;border-radius:20px;margin-top:32px"></div>
    </section>
}
