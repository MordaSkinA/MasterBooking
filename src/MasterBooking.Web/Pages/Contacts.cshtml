@page
@model MasterBooking.Web.Pages.ContactsModel
@{
    ViewData["Title"] = Model.Settings?.DisplayName ?? "Контакты";
}

@if (Model.Settings != null)
{
    <section class="w">
        <h2 class="s">Контакты</h2>
        <div class="card" style="max-width: 600px;">
            <div class="form-group">
                <label class="f">Телефон</label>
                <div>@Model.Settings.PhoneNumber</div>
            </div>
            <div class="form-group">
                <label class="f">Соцсети</label>
                <div>@Model.Settings.SocialLinks</div>
            </div>
            <div class="form-group">
                <label class="f">Обо мне</label>
                <p>@Model.Settings.AboutMe</p>
            </div>
        </div>
    </section>
}
else
{
    <section class="w">
        <h1>Настройка сайта...</h1>
    </section>
}
