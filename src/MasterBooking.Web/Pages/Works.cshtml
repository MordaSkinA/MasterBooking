@page
@model MasterBooking.Web.Pages.WorksModel
@{
    ViewData["Title"] = Model.Settings?.DisplayName ?? "Работы";
}

@if (Model.Settings != null)
{
    <section class="w">
        <h2 class="s">Мои работы</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr);gap:16px">
            @foreach (var image in Model.Gallery)
            {
                <div class="card" style="height:260px;background-image:url('@image.ImagePath');background-size:cover;background-position:center;padding:0"></div>
            }
        </div>
        @if (Model.Gallery.Any())
        {
            <p style="margin:32px 0 0"><a class="btn" asp-page="/Calendar">Записаться</a></p>
        }
    </section>
}
else
{
    <section class="w">
        <h1>Настройка сайта...</h1>
    </section>
}
