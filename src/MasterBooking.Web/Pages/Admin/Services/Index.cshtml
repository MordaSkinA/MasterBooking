@page
@model MasterBooking.Web.Pages.Admin.Services.IndexModel
@{
    ViewData["Title"] = "Услуги";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Услуги</h1>
    <a asp-page="Create" class="btn btn-primary">Добавить услугу</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Цена</th>
            <th>Длительность (мин)</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Services)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Duration</td>
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Активна</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Неактивна</span>
                    }
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                    <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>