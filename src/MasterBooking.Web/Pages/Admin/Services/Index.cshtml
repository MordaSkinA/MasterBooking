@page
@model MasterBooking.Web.Pages.Admin.Services.IndexModel
@{
    ViewData["Title"] = "Услуги";
    Layout = "_AdminLayout";
}

<div class="top">
    <h1>Услуги</h1>
    <a class="btn" asp-page="Create">Новая услуга</a>
</div>

<p class="muted" style="margin:0">Услуги и цены из этого списка показываются на публичной странице. Выключатель скрывает услугу с сайта.</p>

<div class="card tbl">
    <div>
        <div class="r h" style="grid-template-columns:1.6fr 140px 120px 130px 110px"><span>Название</span><span>Длительность</span><span>Цена</span><span>На сайте</span><span></span></div>
        @foreach (var item in Model.Services)
        {
            <div class="r" style="grid-template-columns:1.6fr 140px 120px 130px 110px">
                <b>@item.Name</b>
                <span>@item.Duration.Minutes()</span>
                <span>@item.Price.Rub()</span>
                <span>
                    <form method="post" asp-page-handler="Toggle" asp-route-id="@item.Id" style="margin:0">
                        <button type="submit" class="tog@(item.IsVisible ? "" : " off")" style="border:0;padding:0;cursor:pointer" aria-label="На сайте"></button>
                    </form>
                </span>
                <span><a asp-page="Edit" asp-route-id="@item.Id">Изменить</a></span>
            </div>
        }
        @if (!Model.Services.Any())
        {
            <div class="r muted" style="grid-template-columns:1fr">Услуг пока нет</div>
        }
    </div>
</div>
