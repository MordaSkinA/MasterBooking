@page
@model MasterBooking.Web.Pages.Admin.Services.DeleteModel
@{
    ViewData["Title"] = "Удалить услугу";
    Layout = "_AdminLayout";
}

<div class="top"><h1>Удалить услугу</h1></div>

<form method="post" class="card form" style="max-width:640px">
    <input type="hidden" asp-for="Service.Id" />
    <div style="font-weight:800;font-size:20px">@Model.Service.Name</div>
    <div class="muted">@Model.Service.Duration.Minutes() · @Model.Service.Price.Rub()</div>
    <p class="muted" style="margin:0">Это действие нельзя будет отменить.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap"><button class="btn" type="submit" style="background:#7A2E12">Подтвердить удаление</button><a class="btn2 gray" asp-page="Index">Отмена</a></div>
</form>
