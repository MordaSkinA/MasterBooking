@page
@model MasterBooking.Web.Pages.Admin.Services.EditModel
@{
    ViewData["Title"] = "Изменить услугу";
    Layout = "_AdminLayout";
}

<div class="top"><h1>Изменить услугу</h1></div>

<form method="post" class="card form" style="max-width:640px">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" style="color:#7A2E12;font-weight:600;font-size:14px"></div>
    <label class="f">Название<input type="text" asp-for="Input.Name"><span asp-validation-for="Input.Name" style="color:#7A2E12;font-size:14px"></span></label>
    <div class="cols">
        <label class="f">Цена, ₽<input type="text" inputmode="decimal" asp-for="Input.Price"><span asp-validation-for="Input.Price" style="color:#7A2E12;font-size:14px"></span></label>
        <label class="f">Длительность, мин<input type="text" inputmode="numeric" asp-for="Input.Duration"><span asp-validation-for="Input.Duration" style="color:#7A2E12;font-size:14px"></span></label>
    </div>
    <label style="display:flex;gap:10px;align-items:center;font-weight:600"><input type="checkbox" asp-for="Input.IsVisible" style="width:20px;height:20px">На сайте</label>
    <div style="display:flex;gap:12px;flex-wrap:wrap"><button class="btn" type="submit">Сохранить изменения</button><a class="btn2 gray" asp-page="Index">Отмена</a></div>
</form>
