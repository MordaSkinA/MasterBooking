@page
@model MasterBooking.Web.Pages.Admin.Clients.EditModel
@{
    ViewData["Title"] = "Изменить клиента";
    Layout = "_AdminLayout";
}

<div class="top"><h1>Изменить клиента</h1></div>

<form method="post" class="card form" style="max-width:640px">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" style="color:#7A2E12;font-weight:600;font-size:14px"></div>
    <label class="f">Имя<input type="text" asp-for="Input.Name"><span asp-validation-for="Input.Name" style="color:#7A2E12;font-size:14px"></span></label>
    <label class="f">Телефон<input type="tel" asp-for="Input.PhoneNumber"><span asp-validation-for="Input.PhoneNumber" style="color:#7A2E12;font-size:14px"></span></label>
    <label class="f">Заметка<textarea asp-for="Input.Notes"></textarea></label>
    <div style="display:flex;gap:12px;flex-wrap:wrap"><button class="btn" type="submit">Сохранить изменения</button><a class="btn2 gray" asp-page="Index">Отмена</a></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
