@page
@model MasterBooking.Web.Pages.Admin.Clients.DeleteModel
@{
    ViewData["Title"] = "Удалить клиента";
    Layout = "_AdminLayout";
}

<div class="top"><h1>Удалить клиента</h1></div>

<form method="post" class="card form" style="max-width:640px">
    <input type="hidden" asp-for="Client.Id" />
    <div style="font-weight:800;font-size:20px">@Model.Client.Name</div>
    @if (!string.IsNullOrEmpty(Model.Client.PhoneNumber))
    {
        <div class="muted">@Model.Client.PhoneNumber</div>
    }
    <p class="muted" style="margin:0">Это действие нельзя будет отменить.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap"><button class="btn" type="submit" style="background:#7A2E12">Подтвердить удаление</button><a class="btn2 gray" asp-page="Index">Отмена</a></div>
</form>
