@page
@model MasterBooking.Web.Pages.Admin.Clients.DeleteModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Удалить клиента";
}

<div class="card border-0 shadow-sm border-start border-danger border-4">
    <div class="card-body p-4">
        <h3 class="fw-bold text-danger">Вы уверены, что хотите удалить этого клиента?</h3>
        <p class="text-muted">Это действие нельзя будет отменить.</p>

        <hr>

        <div class="mb-4">
            <p class="mb-1 small text-muted">Имя</p>
            <p class="fs-5 fw-semibold">@Model.Client.Name</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Client.PhoneNumber))
        {
            <div class="mb-4">
                <p class="mb-1 small text-muted">Телефон</p>
                <p class="fs-5 fw-semibold">@Model.Client.PhoneNumber</p>
            </div>
        }

        <form method="post">
            <input type="hidden" asp-for="Client.Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i> Подтвердить удаление
            </button>
            <a asp-page="./Index" class="btn btn-outline-secondary ms-2">Отмена</a>
        </form>
    </div>
</div>
