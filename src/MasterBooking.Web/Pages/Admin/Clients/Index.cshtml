@page
@model MasterBooking.Web.Pages.Admin.Clients.IndexModel
@{
    ViewData["Title"] = "Клиенты";
    Layout = "_AdminLayout";
    var filter = Model.Filter is "regular" or "lapsed" ? Model.Filter : "all";
    string Chip(string key) => key == filter ? "chip on" : "chip";
}

<div class="top">
    <h1>Клиенты</h1>
    <a class="btn" asp-page="Create">Новый клиент</a>
</div>

<div style="display:flex;gap:12px;flex-wrap:wrap">
    <form method="get" style="display:contents">
        <input type="hidden" name="filter" value="@(filter == "all" ? "" : filter)">
        <input type="search" name="q" value="@Model.Q" placeholder="Поиск по имени или телефону" style="flex:1;min-width:240px">
    </form>
    <div class="chips">
        <a class="@Chip("all")" asp-page="Index" asp-route-q="@Model.Q">Все</a>
        <a class="@Chip("regular")" asp-page="Index" asp-route-q="@Model.Q" asp-route-filter="regular">Постоянные</a>
        <a class="@Chip("lapsed")" asp-page="Index" asp-route-q="@Model.Q" asp-route-filter="lapsed">Давно не были</a>
    </div>
</div>

<div class="two">
    <div class="card tbl">
        <div style="min-width:0">
            <div class="r h" style="grid-template-columns:1.2fr 1.1fr 1fr 70px 90px"><span>Имя</span><span>Телефон</span><span>Последний визит</span><span>Визитов</span><span>Сумма</span></div>
            @foreach (var row in Model.Rows)
            {
                <div class="r" style="grid-template-columns:1.2fr 1.1fr 1fr 70px 90px">
                    <b><a asp-page="Index" asp-route-id="@row.Client.Id" asp-route-q="@Model.Q" asp-route-filter="@(filter == "all" ? null : filter)" style="color:inherit;text-decoration:none">@row.Client.Name</a></b>
                    <span>@row.Client.PhoneNumber</span>
                    <span>@(row.LastVisit is { } last ? MasterTime.ToLocal(last, Model.Zone).DayMonth() : "")</span>
                    <span>@row.Visits</span>
                    <span>@row.Total.Rub()</span>
                </div>
            }
            @if (!Model.Rows.Any())
            {
                <div class="r muted" style="grid-template-columns:1fr">Клиентов не найдено</div>
            }
        </div>
    </div>
    @if (Model.Selected != null)
    {
        <div class="card" style="padding:24px;display:flex;flex-direction:column;gap:16px">
            <div>
                <div style="font-weight:800;font-size:20px">@Model.Selected.Client.Name</div>
                <div class="muted">@Model.Selected.Client.PhoneNumber</div>
            </div>
            <div>
                <div class="muted" style="font-size:13px;font-weight:700;margin-bottom:6px">ЗАМЕТКИ</div>
                <div style="border:1px solid #E6E0EF;border-radius:10px;padding:12px;min-height:72px" class="muted">@Model.Selected.Client.Notes</div>
            </div>
            <div>
                <div class="muted" style="font-size:13px;font-weight:700;margin-bottom:6px">ИСТОРИЯ ВИЗИТОВ</div>
                @foreach (var visit in Model.History)
                {
                    <div style="display:flex;justify-content:space-between;padding:10px 0;border-top:1px solid #E6E0EF"><span>@visit.Date.DayMonth() · @visit.Service</span><b>@visit.Price.Rub()</b></div>
                }
            </div>
            <a class="btn" asp-page="/Admin/Appointments/Create" asp-route-clientId="@Model.Selected.Client.Id">Записать клиента</a>
        </div>
    }
    else
    {
        <div class="card" style="padding:24px"></div>
    }
</div>
