@page
@model MasterBooking.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Записи на неделю";
    Layout = "_AdminLayout";
}

<div class="top">
    <h1>Записи на неделю</h1>
    <a class="btn" asp-page="/Admin/Appointments/Create">Новая запись</a>
</div>

<div class="stats">
    <div class="card stat"><div class="l">Доход за месяц</div><div class="v">@Model.MonthlyRevenue.Rub()</div></div>
    <div class="card stat"><div class="l">Записей на неделе</div><div class="v">@Model.WeeklyAppointmentCount</div></div>
    <div class="card stat"><div class="l">Средний чек</div><div class="v">@Model.AverageCheck.Rub()</div></div>
</div>

<div class="card tbl">
    <div>
        <div class="r h" style="grid-template-columns:90px 1.4fr 1.4fr 140px 100px"><span>Время</span><span>Клиент</span><span>Услуга</span><span>Статус</span><span>Цена</span></div>
        @foreach (var appt in Model.WeeklyAppointments)
        {
            <div class="r" style="grid-template-columns:90px 1.4fr 1.4fr 140px 100px">
                <b>@MasterTime.ToLocal(appt.StartDateTime, Model.Zone).ToString("HH:mm")</b>
                <span>@appt.Client?.Name</span>
                <span>@appt.Service?.Name</span>
                <span><span class="t @AppointmentStatus.Css(appt.Status)">@AppointmentStatus.Text(appt.Status)</span></span>
                <span>@appt.FinalPrice.Rub()</span>
            </div>
        }
        @if (!Model.WeeklyAppointments.Any())
        {
            <div class="r muted" style="grid-template-columns:1fr">На этой неделе записей пока нет</div>
        }
    </div>
</div>
