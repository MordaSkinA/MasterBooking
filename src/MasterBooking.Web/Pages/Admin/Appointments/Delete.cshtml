@page
@model MasterBooking.Web.Pages.Admin.Appointments.DeleteModel
@{
    ViewData["Title"] = "Удалить запись";
}

<h1 class="text-danger">Удалить запись</h1>
<h3>Вы уверены, что хотите удалить эту запись?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Клиент</dt>
        <dd class="col-sm-9">@Model.Appointment.Client?.Name</dd>

        <dt class="col-sm-3">Услуга</dt>
        <dd class="col-sm-9">@Model.Appointment.Service?.Name</dd>

        <dt class="col-sm-3">Дата начала</dt>
        <dd class="col-sm-9">@Model.Appointment.StartDateTime.ToString("dd.MM.yyyy HH:mm")</dd>

        <dt class="col-sm-3">Дата окончания</dt>
        <dd class="col-sm-9">@Model.Appointment.EndDateTime.ToString("dd.MM.yyyy HH:mm")</dd>

        <dt class="col-sm-3">Статус</dt>
        <dd class="col-sm-9">@Model.Appointment.Status</dd>

        <dt class="col-sm-3">Цена</dt>
        <dd class="col-sm-9">@Model.Appointment.FinalPrice.ToString("C")</dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Appointment.Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a asp-page="./Index" class="btn btn-secondary">Назад</a>
    </form>
</div>
