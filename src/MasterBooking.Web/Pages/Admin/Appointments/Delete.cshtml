@page
@model MasterBooking.Web.Pages.Admin.Appointments.DeleteModel
@{
    ViewData["Title"] = "Удалить запись";
    Layout = "_AdminLayout";
}

<div class="top"><h1>Удалить запись</h1></div>

<form method="post" class="card form" style="max-width:640px">
    <input type="hidden" asp-for="Appointment.Id" />
    <div style="font-weight:800;font-size:20px">@Model.Appointment.Client?.Name</div>
    <div class="muted">@Model.Appointment.Service?.Name · @Model.Appointment.FinalPrice.Rub()</div>
    <div class="muted">@Model.Appointment.StartDateTime.DayMonth() · @AppointmentStatus.Text(Model.Appointment.Status)</div>
    <p class="muted" style="margin:0">Это действие нельзя будет отменить.</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap"><button class="btn" type="submit" style="background:#7A2E12">Подтвердить удаление</button><a class="btn2 gray" href="/Admin">Отмена</a></div>
</form>
