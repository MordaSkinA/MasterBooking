@page
@model MasterBooking.Web.Pages.Admin.Appointments.IndexModel
@{
    ViewData["Title"] = "Записи";
}

<h1>Записи</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Создать запись</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Дата и время</th>
            <th>Клиент</th>
            <th>Услуга</th>
            <th>Статус</th>
            <th>Цена</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Appointments)
{
        <tr>
            <td>@item.StartDateTime.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@item.Client?.Name</td>
            <td>@item.Service?.Name</td>
            <td>@item.Status</td>
            <td>@item.FinalPrice.ToString("C")</td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Редактировать</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Удалить</a>
            </td>
        </tr>
}
    </tbody>
</table>
