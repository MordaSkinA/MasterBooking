@page
@model MasterBooking.Web.Pages.Admin.Appointments.IndexModel
@{
    ViewData["Title"] = "Записи";
    Layout = "_AdminLayout";
}

<div style="display:flex; justify-content:space-between; align-items:center">
    <h1 class="s">Записи</h1>
    <a asp-page="Create" class="btn">Создать запись</a>
</div>

<div class="card" style="overflow:hidden">
    <table style="width:100%;border-collapse:collapse;font-size:15px">
        <thead style="background:#F5F3F7;text-align:left">
            <tr>
                <th style="padding:12px 20px">Дата и время</th>
                <th style="padding:12px 20px">Клиент</th>
                <th style="padding:12px 20px">Услуга</th>
                <th style="padding:12px 20px">Цена</th>
                <th style="padding:12px 20px">Действие</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Appointments)
            {
                <tr style="border-top:1px solid #E6E0EF">
                    <td style="padding:12px 20px">
                        @item.StartDateTime.ToString("HH:mm")
                        <span class="t p" style="margin-left:8px">@item.StartDateTime.DayMonth()</span>
                    </td>
                    <td style="padding:12px 20px">@item.Client?.Name</td>
                    <td style="padding:12px 20px">@item.Service?.Name</td>
                    <td style="padding:12px 20px">@item.FinalPrice.Rub()</td>
                    <td style="padding:12px 20px">
                        <div style="display:flex; gap:8px">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn2">Изменить</a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn2 gray">Удалить</a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Appointments.Any())
            {
                <tr>
                    <td colspan="5" style="padding:40px; text-align:center; color:#6A6277">Записей пока нет.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
