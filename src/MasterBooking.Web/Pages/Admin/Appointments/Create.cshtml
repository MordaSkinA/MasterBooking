@page
@model MasterBooking.Web.Pages.Admin.Appointments.CreateModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Создать запись";
}

<div class="row">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Новая запись</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Input.ClientId" class="form-label small text-muted">Клиент</label>
                        <select asp-for="Input.ClientId" class="form-select" asp-items="Model.Clients">
                            <option value="">-- Выберите клиента --</option>
                        </select>
                        <span asp-validation-for="Input.ClientId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ServiceId" class="form-label small text-muted">Услуга</label>
                        <select asp-for="Input.ServiceId" class="form-select" asp-items="Model.Services">
                            <option value="">-- Выберите услугу --</option>
                        </select>
                        <span asp-validation-for="Input.ServiceId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.StartDateTime" class="form-label small text-muted">Дата и время начала</label>
                        <input asp-for="Input.StartDateTime" class="form-control" type="datetime-local" />
                        <span asp-validation-for="Input.StartDateTime" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.FinalPrice" class="form-label small text-muted">Цена</label>
                        <input asp-for="Input.FinalPrice" class="form-control" />
                        <span asp-validation-for="Input.FinalPrice" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Status" class="form-label small text-muted">Статус</label>
                        <select asp-for="Input.Status" class="form-select">
                            <option value="Planned">Запланировано</option>
                            <option value="Done">Выполнено</option>
                            <option value="Cancelled">Отменено</option>
                        </select>
                        <span asp-validation-for="Input.Status" class="text-danger"></span>
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">Создать запись</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">Отмена</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
