@page
@model MasterBooking.Web.Pages.Admin.Appointments.CreateModel
@{
    ViewData["Title"] = "Новая запись";
    Layout = "_AdminLayout";
}

<div class="top"><h1>Новая запись</h1></div>

<form method="post" class="card form" style="max-width:640px">
    @if (!ViewData.ModelState.IsValid)
    {
        <div style="background:#F6DDD3;color:#7A2E12;border-radius:10px;padding:12px 14px;font-weight:600;font-size:14px">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).Distinct())
            {
                <div>@error</div>
            }
        </div>
    }
    <label class="f">Клиент<select asp-for="Input.ClientId" asp-items="Model.Clients"><option value="">Выберите клиента</option></select></label>
    <label class="f">Услуга<select asp-for="Input.ServiceId" asp-items="Model.Services"><option value="">Выберите услугу</option></select></label>
    <div class="cols">
        <label class="f">Дата<input type="date" asp-for="Input.Date"></label>
        <label class="f">Время<input type="time" asp-for="Input.Time"></label>
    </div>
    <label class="f">Заметка<textarea asp-for="Input.Notes"></textarea></label>
    <div style="display:flex;gap:12px;flex-wrap:wrap"><button class="btn" type="submit">Сохранить запись</button><a class="btn2 gray" href="/Admin">Отмена</a></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
