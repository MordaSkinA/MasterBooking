@page
@model IndexModel
@{
    ViewData["Title"] = "Настройки";
    Layout = "_AdminLayout";
}

<h1 class="s">Настройки</h1>

<form method="post">
    <div class="card" style="padding:24px;display:flex;flex-direction:column;gap:20px">
        <h2 style="margin:0">Профиль мастера</h2>

        <label class="f">
            Имя
            <input type="text" asp-for="Settings.DisplayName" required>
        </label>

        <label class="f">
            О себе
            <textarea asp-for="Settings.AboutMe"></textarea>
        </label>

        <label class="f">
            Телефон
            <input type="tel" asp-for="Settings.PhoneNumber">
        </label>

        <label class="f">
            Социальные сети (URL)
            <input type="text" asp-for="Settings.SocialLinks">
        </label>

        <hr style="border:0;border-top:1px solid #E6E0EF;margin:8px 0">

        <h2 style="margin:0">Визуальное оформление</h2>

        <label class="f">
            Основной цвет
            <input type="text" asp-for="Settings.PrimaryColor">
        </label>

        <label class="f">
            Тема
            <select asp-for="Settings.Theme">
                <option value="Light">Светлая</option>
                <option value="Dark">Темная</option>
            </select>
        </label>

        <label class="f">
            Обложка
            <input type="file" name="CoverImageFile" accept="image/*">
        </label>

        <label class="f">
            Логотип
            <input type="file" name="LogoFile" accept="image/*">
        </label>

        <label class="f">
            Часовой пояс (ID, например: Russian Standard Time)
            <input type="text" asp-for="Settings.TimeZoneId">
        </label>

        <div style="margin-top:16px">
            <button type="submit" class="btn">Сохранить изменения</button>
        </div>
    </div>
</form>
