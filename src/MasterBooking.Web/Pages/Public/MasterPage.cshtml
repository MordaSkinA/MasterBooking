@page "/m/{slug?}"
@model MasterBooking.Web.Pages.Public.MasterPageModel
@{
    Layout = "_PublicLayout";
    var settings = Model.Settings;
    var name = settings?.DisplayName ?? "Мастер";
    ViewData["Title"] = name;
    ViewData["Accent"] = settings?.PrimaryColor;
    ViewData["Theme"] = settings?.Theme;
    ViewData["Description"] = "Услуги, работы и свободное время мастера " + name;

    var coverImage = settings?.CoverImage;
    var logo = settings?.Logo;
    var aboutMe = settings?.AboutMe;
    var phone = settings?.PhoneNumber;
    var showCalendar = settings?.ShowCalendar ?? true;
    var phoneHref = string.IsNullOrWhiteSpace(phone) ? string.Empty : "tel:" + new string(phone.Where(c => char.IsDigit(c) || c == '+').ToArray());
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    var socials = new List<(string Url, string Label)>();
    foreach (var raw in (settings?.SocialLinks ?? string.Empty).Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
    {
        if (Uri.TryCreate(raw, UriKind.Absolute, out var uri) && (uri.Scheme == Uri.UriSchemeHttp || uri.Scheme == Uri.UriSchemeHttps))
        {
            socials.Add((uri.AbsoluteUri, uri.Host.StartsWith("www.") ? uri.Host.Substring(4) : uri.Host));
        }
    }

    var hasServices = Model.Services.Any();
    var hasGallery = Model.Gallery.Any();
    var hasContacts = !string.IsNullOrEmpty(phoneHref) || socials.Any();
}

<style>
    .hero-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
        align-items: center;
        padding: 32px;
        max-width: 1120px;
        margin: 0 auto;
    }
    .hero-text {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }
    .hero-text h1 {
        margin: 0;
        font-size: 52px;
        line-height: 1.1;
        font-weight: 800;
    }
    .hero-about {
        margin: 0;
        font-size: 18px;
        line-height: 1.6;
        color: #4A4558;
    }
    .hero-cover {
        height: 380px;
        border-radius: 24px;
        background: #E6E0EF;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6A6277;
        font-weight: 600;
        overflow: hidden;
    }
    .hero-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .hero-cover-empty {
        font-size: 80px;
    }
    .btn-accent-new {
        align-self: flex-start;
        background: var(--accent, #5B2F91);
        color: #fff;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 700;
        text-decoration: none;
        min-height: 44px;
        box-sizing: border-box;
    }
    .section-block {
        max-width: 1120px;
        margin: 0 auto;
        padding: 48px 32px;
    }
    .section-title {
        margin: 0 0 24px;
        font-size: 32px;
        font-weight: 800;
    }
    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
    }
    .service-card {
        background: #fff;
        border: 1px solid #E6E0EF;
        border-radius: 16px;
        padding: 24px;
    }
    .service-name {
        font-weight: 800;
        font-size: 18px;
    }
    .service-time {
        color: #6A6277;
        margin: 6px 0 16px;
    }
    .service-price {
        font-weight: 800;
        font-size: 22px;
    }
    .works-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
    }
    .work-shot {
        height: 260px;
        border-radius: 16px;
        background: #E6E0EF;
        border: none;
        padding: 0;
        cursor: pointer;
        overflow: hidden;
    }
    .work-shot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .contacts-container {
        display: flex;
        gap: 32px;
        flex-wrap: wrap;
        font-size: 18px;
        font-weight: 600;
    }
    .contacts-item {
        display: flex;
        align-items: center;
    }
</style>

<header class="top wrap">
    <a href="#top" class="top-name">
        @if (!string.IsNullOrEmpty(logo))
        {
            <img src="@logo" alt="" class="top-logo" />
        }
        <span>@name</span>
    </a>
    <nav class="top-nav" aria-label="Разделы страницы">
        @if (hasServices) { <a href="#services">Услуги</a> }
        @if (hasGallery) { <a href="#works">Работы</a> }
        @if (showCalendar) { <a href="#calendar">Календарь</a> }
        @if (hasContacts) { <a href="#contacts">Контакты</a> }
    </nav>
</header>

<section class="hero-section wrap" id="top">
    <div class="hero-text">
        <h1>@name</h1>
        @if (!string.IsNullOrWhiteSpace(aboutMe))
        {
            <p class="hero-about">@aboutMe</p>
        }
        @if (showCalendar)
        {
            <a class="btn-accent-new" href="#calendar">Посмотреть свободное время</a>
        }
        else if (!string.IsNullOrEmpty(phoneHref))
        {
            <a class="btn-accent-new" href="@phoneHref">Позвонить</a>
        }
    </div>
    <div class="hero-cover">
        @if (!string.IsNullOrEmpty(coverImage))
        {
            <img src="@coverImage" alt="@name" />
        }
        else
        {
            <div class="hero-cover-empty" aria-hidden="true">@initials</div>
        }
    </div>
</section>

@if (hasServices)
{
    <section class="section-block" id="services">
        <h2 class="section-title">Услуги и цены</h2>
        <div class="services-grid">
            @foreach (var service in Model.Services)
            {
                <div class="service-card">
                    <div class="service-name">@service.Name</div>
                    <div class="service-time">@service.Duration.Minutes() мин</div>
                    <div class="service-price">@service.Price.Rub()</div>
                </div>
            }
        </div>
    </section>
}

@if (hasGallery)
{
    <section class="section-block" id="works">
        <h2 class="section-title">Работы</h2>
        <div class="works-grid">
            @foreach (var image in Model.Gallery)
            {
                <button type="button" class="work-shot" data-full="@image.ImagePath" aria-label="Открыть фото крупно">
                    <img src="@image.ImagePath" alt="Работа мастера" loading="lazy" />
                </button>
            }
        </div>
    </section>
}

@if (showCalendar)
{
    <section class="section-block wrap" id="calendar">
        <h2 class="section-title">Свободное время</h2>
        <p class="block-note">Серым отмечено занятое время. Чтобы записаться, напишите или позвоните мастеру.</p>
        <div class="week-nav">
            <button type="button" class="week-btn" id="weekPrev" aria-label="Предыдущая неделя">←</button>
            <span class="week-label" id="weekLabel"></span>
            <button type="button" class="week-btn" id="weekNext" aria-label="Следующая неделя">→</button>
        </div>
        <div class="cal-scroll">
            <div class="cal-grid" id="calGrid" aria-live="polite"></div>
        </div>
    </section>
}

@if (hasContacts)
{
    <section class="section-block" id="contacts">
        <h2 class="section-title">Контакты</h2>
        <div class="contacts-container">
            @if (!string.IsNullOrEmpty(phoneHref))
            {
                <a href="@phoneHref" class="contacts-item">@phone</a>
            }
            @foreach (var social in socials)
            {
                <a href="@social.Url" target="_blank" rel="noopener noreferrer" class="contacts-item">@social.Label</a>
            }
        </div>
    </section>
}

<footer class="foot wrap">© @DateTime.Now.Year @name</footer>

<dialog id="lightbox" class="lightbox">
    <form method="dialog"><button class="lightbox-close" aria-label="Закрыть">×</button></form>
    <img id="lightboxImg" alt="Работа мастера" />
</dialog>

@section Scripts {
    <script>
        (function () {
            var box = document.getElementById('lightbox');
            var img = document.getElementById('lightboxImg');
            document.querySelectorAll('.work-shot').forEach(function (b) {
                b.addEventListener('click', function () {
                    img.src = b.dataset.full;
                    box.showModal();
                });
            });
            box.addEventListener('click', function (e) {
                if (e.target === box) box.close();
            });
        })();
    </script>
    @if (showCalendar)
    {
        <script>
            (function () {
                var slug = '';
                var firstHour = 10;
                var lastHour = 19;
                var maxWeeksAhead = 8;
                var grid = document.getElementById('calGrid');
                var label = document.getElementById('weekLabel');
                var prev = document.getElementById('weekPrev');
                var next = document.getElementById('weekNext');
                var dayNames = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];
                var monthNames = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
                var busy = [];
                var offset = 0;

                function mondayOf(date) {
                    var d = new Date(date.getFullYear(), date.getMonth(), date.getDate());
                    d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
                    return d;
                }

                function pad(n) { return n < 10 ? '0' + n : String(n); }

                function isBusy(from, to) {
                    for (var i = 0; i < busy.length; i++) {
                        if (from < busy[i].end && to > busy[i].start) return true;
                    }
                    return false;
                }

                function render() {
                    var now = new Date();
                    var monday = mondayOf(now);
                    monday.setDate(monday.getDate() + offset * 7);
                    var sunday = new Date(monday);
                    sunday.setDate(sunday.getDate() + 6);
                    label.textContent = monday.getDate() + ' ' + (monday.getMonth() === sunday.getMonth() ? '' : monthNames[monday.getMonth()] + ' ') + '– ' + sunday.getDate() + ' ' + monthNames[sunday.getMonth()];
                    prev.disabled = offset <= 0;
                    next.disabled = offset >= maxWeeksAhead;
                    var html = '';
                    for (var d = 0; d < 7; d++) {
                        var day = new Date(monday);
                        day.setDate(monday.getDate() + d);
                        html += '<div class="cal-day"><h3 style="text-align:center;font-size:14px;margin-bottom:8px">' + dayNames[d] + ' ' + day.getDate() + '</h3>';
                        for (var h = firstHour; h <= lastHour; h++) {
                            var from = new Date(day.getFullYear(), day.getMonth(), day.getDate(), h, 0);
                            var to = new Date(day.getFullYear(), day.getMonth(), day.getDate(), h + 1, 0);
                            if (to <= now) {
                                html += '<div class="slot busy">–</div>';
                            } else if (isBusy(from, to)) {
                                html += '<div class="slot busy">Занято</div>';
                            } else {
                                html += '<div class="slot">' + pad(h) + ':00</div>';
                            }
                        }
                        html += '</div>';
                    }
                    grid.innerHTML = html;
                }

                prev.addEventListener('click', function () { offset--; render(); });
                next.addEventListener('click', function () { offset++; render(); });

                render();

                fetch('/m/' + encodeURIComponent(slug) + '?handler=BusyIntervals')
                    .then(function (r) {
                        if (!r.ok) throw new Error('busy');
                        return r.json();
                    })
                    .then(function (items) {
                        busy = items.map(function (x) {
                            return { start: new Date(x.start), end: new Date(x.end) };
                        });
                        render();
                    })
                    .catch(function () {
                        label.textContent = 'Не удалось загрузить расписание';
                    });
            })();
        </script>
    }
}
