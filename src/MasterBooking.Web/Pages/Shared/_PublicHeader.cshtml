@using Microsoft.EntityFrameworkCore
@inject MasterBooking.Infrastructure.Data.ApplicationDbContext DbContext
@{
    var path = (Context.Request.Path.Value ?? "/").TrimEnd('/');
    string Cls(string p) => path.Equals(p, StringComparison.OrdinalIgnoreCase) ? "on" : "";

    var settings = DbContext.SiteSettings.FirstOrDefault();
    var masterName = settings?.DisplayName ?? "master-booking";
}
<header class="s">
    <a class="brand" href="/">@masterName</a>
    <nav class="s">
        <a class="@Cls("/services")" href="/services">Услуги</a>
        <a class="@Cls("/works")" href="/works">Работы</a>
        <a class="@Cls("/calendar")" href="/calendar">Календарь</a>
        <a class="@Cls("/contacts")" href="/contacts">Контакты</a>
    </nav>
</header>
