@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MasterBooking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="site-header">
        <div class="inner">
            <a class="brand" asp-page="/Index">
                master-booking
            </a>
            <nav class="d-flex align-items-center gap-2">
                @if (signedIn)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-page="/Admin/Index">Панель мастера</a>
                    <form asp-page="/Account/Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-light btn-sm">Выйти</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-primary btn-sm" asp-page="/Account/Login">Войти</a>
                }
            </nav>
        </div>
    </header>

    <main class="site-main" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        © @DateTime.Now.Year master-booking
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
