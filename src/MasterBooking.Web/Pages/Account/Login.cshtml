@page
@model MasterBooking.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход в панель";
    Layout = "_AuthLayout";
    var credentialsError = ViewData.ModelState.TryGetValue(string.Empty, out var entry) && entry.Errors.Count > 0;
    var errBorder = "border-color:#7A2E12;";
    var emailBad = credentialsError || ViewData.ModelState["Input.Email"]?.Errors.Count > 0;
    var passBad = credentialsError || ViewData.ModelState["Input.Password"]?.Errors.Count > 0;
}

<div style="font-weight:800;font-size:20px">master-booking</div>
<form method="post" class="card box">
    <div><h1>Вход в панель</h1><p class="muted" style="margin:6px 0 0">Записи, клиенты и настройки вашего сайта.</p></div>
    @if (credentialsError)
    {
        <div style="background:#F6DDD3;color:#7A2E12;border-radius:10px;padding:12px 14px;font-weight:600;font-size:14px">Неверный email или пароль. Проверьте данные и попробуйте ещё раз.</div>
    }
    <label class="f">Email<input type="email" asp-for="Input.Email" autocomplete="username" style="@(emailBad ? errBorder : "")"><span asp-validation-for="Input.Email" style="color:#7A2E12;font-size:14px;font-weight:600"></span></label>
    <label class="f">Пароль<span class="pw"><input type="password" asp-for="Input.Password" id="passwordInput" autocomplete="current-password" style="@(passBad ? errBorder : "")"><a href="#" id="togglePassword">Показать</a></span><span asp-validation-for="Input.Password" style="color:#7A2E12;font-size:14px;font-weight:600"></span></label>
    <button type="submit" class="btn" style="width:100%;min-height:48px;font-size:16px">Войти</button>
</form>
<a href="/" style="font-weight:600;text-decoration:none">← На сайт</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('togglePassword').addEventListener('click', function (e) {
            e.preventDefault();
            var pwd = document.getElementById('passwordInput');
            var show = pwd.type === 'password';
            pwd.type = show ? 'text' : 'password';
            this.textContent = show ? 'Скрыть' : 'Показать';
        });
    </script>
}
