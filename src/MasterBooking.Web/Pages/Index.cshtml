@page
@model IndexModel
@{
    ViewData["Title"] = Model.Settings?.DisplayName ?? "Главная";
    Layout = "_PublicLayout";
}

@if (Model.Settings != null)
{
    <section class="w" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr);gap:40px;align-items:center;padding-top:32px">
        <div style="display:flex;flex-direction:column;gap:20px">
            <h1 class="s">@Model.Settings.DisplayName</h1>
            <p style="margin:0;font-size:18px;line-height:1.6;color:#4A4558">@Model.Settings.AboutMe</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn" asp-page="/Admin/Index" style="align-self:flex-start;padding:14px 28px">Открыть панель</a>
            }
            else
            {
                <a class="btn" asp-page="/Account/Login" style="align-self:flex-start;padding:14px 28px">Войти в панель</a>
            }
        </div>
        <div class="ph" style="height:380px;border-radius:24px;background-image:url('@Model.Settings.CoverImage');background-size:cover;background-position:center">
        </div>
    </section>

    <section class="w">
        <h2 class="s">Услуги и цены</h2>
        <div class="g3">
            @foreach (var service in Model.Services)
            {
                <div class="card svc" style="padding:24px">
                    <div class="n1" style="font-weight:800;font-size:18px">@service.Name</div>
                    <div class="d1" style="color:#6A6277;margin:6px 0 16px">@service.Duration мин.</div>
                    <div class="p1" style="font-weight:800;font-size:22px">@service.Price.ToString("C0")</div>
                </div>
            }
        </div>
        @if (Model.Services.Any())
        {
            <p style="margin:20px 0 0"><a href="/services" style="font-weight:700">Все услуги →</a></p>
        }
    </section>

    <section class="w">
        <h2 class="s">Работы</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr);gap:16px">
            @foreach (var image in Model.Gallery)
            {
                <div style="height:260px;border-radius:16px;background-image:url('@image.ImagePath');background-size:cover;background-position:center"></div>
            }
        </div>
        @if (Model.Gallery.Any())
        {
            <p style="margin:20px 0 0"><a href="/works" style="font-weight:700">Все работы →</a></p>
        }
    </section>
}
else
{
    <section class="w">
        <h1 class="s">Добро пожаловать!</h1>
        <p>Настройка сайта...</p>
    </section>
}
